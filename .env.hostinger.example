SPRING_PROFILES_ACTIVE=prod
PORT=8080
FRONTEND_URL=https://www.softchaos.blog

# Supabase PostgreSQL connection. Use this project's connection details.
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=replace-me

# Generate a long random value and keep this file private on the VPS.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

MEDIA_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=softchaos-media

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@softchaos.blog
